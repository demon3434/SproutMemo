# ── Docker Compose 项目名称 ─────────────────────────────────
COMPOSE_PROJECT_NAME=sproutmemo

# ── 访问配置 ───────────────────────────────────────────────
# 宿主机局域网 IP 或服务器 IP（mDNS 广播及外部客户端访问，例如 192.168.1.100 或 127.0.0.1）
HOST_IP=127.0.0.1
# Web 前端服务对外访问端口
HOST_PORT=8080

# ── 数据持久化目录（宿主机路径，支持相对路径或绝对路径）───────
# 后端数据目录（存放错题图片、音视频附件、备份与日志）
BACKEND_DATA_DIR=./data
# PostgreSQL 数据库存储目录
POSTGRES_DATA_DIR=./pgdata

# ── 安全密钥 ───────────────────────────────────────────────
# 生产环境请修改为随机高强度字符串（例如运行: openssl rand -hex 32）
SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars

# ── 初始超级管理员配置（可选，首次启动初始化生效）───────────
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin123

# ── 镜像设置（可选，本地直接 docker compose up --build 构建时无需修改）
PG_IMAGE=postgres:16-alpine
# BACKEND_IMAGE=sproutmemo-backend:latest
# WEB_IMAGE=sproutmemo-web:latest

